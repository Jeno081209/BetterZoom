{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlarialZoom config",
  "type": "object",
  "properties": {
    "zoomMode": { "type": "integer", "enum": [0, 1], "description": "0 = Hold, 1 = Toggle" },
    "showZoomButton": { "type": "boolean" },
    "buttonBgSize": { "type": "integer", "minimum": 48, "maximum": 480 },
    "buttonIconSize": { "type": "integer", "minimum": 24, "maximum": 480 },
    "buttonX": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "buttonY": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "buttonIconOpacity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "buttonBgOpacity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "keybind": { "type": "string" },
    "defaultZoomLevel": { "type": "number", "minimum": 1, "maximum": 80 },
    "useScroll": { "type": "boolean" },
    "zoomSensitivity": { "type": "number", "minimum": 1, "maximum": 30 },
    "disableAnimation": { "type": "boolean" },
    "animationSpeed": { "type": "number", "minimum": 0.05, "maximum": 2 },
    "saveZoomLevel": { "type": "boolean" },
    "alwaysAnimate": { "type": "boolean" },
    "hideHand": { "type": "boolean" },
    "lowSensitivity": { "type": "boolean" },
    "lowSensitivityStrength": { "type": "number", "minimum": 0, "maximum": 1 },
    "cinematicCamera": { "type": "boolean" },
    "smoothing": { "type": "boolean" },
    "smoothness": { "type": "number", "minimum": 1, "maximum": 10 },
    "cinematicBars": { "type": "boolean" },
    "cinematicBarHeight": { "type": "number", "minimum": 0.05, "maximum": 0.5 },
    "cinematicBarColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "showZoomLevel": { "type": "boolean" },
    "hideHud": { "type": "boolean" }
  }
}
